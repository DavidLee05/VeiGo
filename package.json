{
  "name": "veigo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "dev:gateway": "dotnet run --project backend/gateway/VeiGo.Gateway/VeiGo.Gateway.csproj",
    "backend:restore": "dotnet restore backend/VeiGo.sln",
    "backend:build": "dotnet build backend/VeiGo.sln --no-restore",
    "compose:up": "docker compose --env-file .env -f infra/docker-compose.yml up --build -d",
    "compose:down": "docker compose --env-file .env -f infra/docker-compose.yml down --remove-orphans",
    "compose:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs --follow"
  }
}
