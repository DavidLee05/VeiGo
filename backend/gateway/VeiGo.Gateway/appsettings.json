{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-api": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/users"
          }
        ]
      },
      "catalog-api": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/catalog"
          }
        ]
      },
      "search-api": {
        "ClusterId": "search",
        "Match": {
          "Path": "/api/v1/search/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/search"
          }
        ]
      },
      "booking-api": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/bookings"
          }
        ]
      },
      "payment-api": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/payments"
          }
        ]
      },
      "dealer-api": {
        "ClusterId": "dealer",
        "Match": {
          "Path": "/api/v1/dealers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/dealers"
          }
        ]
      },
      "inventory-api": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/inventory"
          }
        ]
      },
      "rental-api": {
        "ClusterId": "rental",
        "Match": {
          "Path": "/api/v1/rentals/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/rentals"
          }
        ]
      },
      "notification-api": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/notifications"
          }
        ]
      }
    },
    "Clusters": {
      "user": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5202/"
          }
        }
      },
      "search": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5203/"
          }
        }
      },
      "booking": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5204/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5205/"
          }
        }
      },
      "dealer": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5207/"
          }
        }
      },
      "rental": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5208/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5209/"
          }
        }
      }
    }
  }
}
